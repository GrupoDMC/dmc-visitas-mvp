# =====================================================================
# DMC Contingencia · plantilla de variables de entorno
# ---------------------------------------------------------------------
# Único archivo .env versionado (ver .gitignore). Es documentación:
# NO pongas credenciales, hosts ni secretos reales aquí.
#
# Local:
#     cp .env.example .env.development     # y rellena los valores
#     npm run secreto                      # genera SESSION_SECRET
#
# Producción (Vercel u otro): estas variables se definen en el panel de
# entorno del despliegue, no en un archivo. Las variables del sistema
# tienen precedencia sobre cualquier .env*.
#
# Todas se leen server-side (lib/env.ts, lib/db/config.ts). NINGUNA debe
# llevar prefijo NEXT_PUBLIC_: eso las publicaría en el bundle del
# navegador junto con la contraseña de la base de datos.
# =====================================================================

# --- Sesión ----------------------------------------------------------

# OBLIGATORIA. Clave con la que se firma la cookie de sesión (HMAC-SHA256).
# Mínimo 32 caracteres. Genérala con `npm run secreto`.
# Cambiarla invalida todas las sesiones abiertas.
SESSION_SECRET=

# --- Conexión a SQL Server -------------------------------------------
#
# Ya no hay modo de demostración: TODA la aplicación (login, visitas,
# maestros y checklist) lee y escribe en SQL Server. Sin estas cuatro
# variables la app no arranca.

# Host o IP de la instancia. Para instancia con nombre, usa solo el host
# aquí y el puerto TCP en DB_PORT: el driver tedious no resuelve
# `HOST\INSTANCIA` sin el SQL Browser.
DB_SERVER=

# Puerto TCP. Default: 1433.
DB_PORT=1433

# Nombre de la base de datos.
DB_NAME=

# Autenticación SQL. Usa una cuenta con permisos solo sobre el esquema
# `dmc`, nunca `sa`.
DB_USER=
DB_PASSWORD=

# --- TLS de la conexión ----------------------------------------------

# Cifrado del canal. Default: true. En producción es obligatorio: con
# false la contraseña viajaría en claro y el arranque aborta.
DB_ENCRYPT=true

# true = acepta CUALQUIER certificado del servidor. Necesario en local
# porque SQL Server genera uno autofirmado.
# En producción debe ser false: con true el canal va cifrado pero no se
# valida contra quién se habla, y queda expuesto a man-in-the-middle.
DB_TRUST_SERVER_CERT=false

# --- Pool y tiempos de espera ----------------------------------------

# Conexiones máximas por instancia. En serverless cada instancia abre su
# propio pool, así que conviene un número bajo (2-4). Default: 4.
DB_POOL_MAX=4

# Milisegundos antes de rendirse. Defaults: 15000 ambos.
DB_CONNECT_TIMEOUT_MS=15000
DB_REQUEST_TIMEOUT_MS=15000

# --- Diagnóstico -----------------------------------------------------

# Habilita GET /api/salud, que reporta si la app llega a la base de datos
# y si los catálogos están sembrados. Sin esta variable la ruta responde
# 404. Genérala con `npm run secreto`.
#   curl -H "Authorization: Bearer <token>" https://<app>/api/salud
HEALTHCHECK_TOKEN=
