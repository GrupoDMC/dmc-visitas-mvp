# =====================================================================
# DMC Contingencia · plantilla de variables de entorno
# ---------------------------------------------------------------------
# Este es el ÚNICO archivo .env que se versiona (ver .gitignore).
# No pongas credenciales reales aquí: solo la plantilla documentada.
#
# Cópialo para crear tus archivos locales:
#     cp .env.example .env.local
#
# Orden de precedencia que aplica Next.js (gana el primero):
#     1. variables del sistema (process.env)   ← lo que se usa en el servidor
#     2. .env.development.local / .env.production.local
#     3. .env.local            ← se carga SIEMPRE, también en producción
#     4. .env.development / .env.production
#     5. .env
#
# OJO con el punto 3: .env.local pisa a .env.production. Si algún día
# haces `npm run build && npm start` en esta misma máquina, las
# credenciales locales ganarían. Por eso .env.local solo lleva los
# secretos de tu SQL local, y los de producción van en el entorno del
# servidor (o en .env.production.local, que nunca sale de ese servidor).
#
# Todas estas variables se leen server-side (lib/db/config.ts).
# NINGUNA debe llevar prefijo NEXT_PUBLIC_: eso las expondría en el
# bundle del navegador junto con la contraseña de la base de datos.
# =====================================================================

# --- Conexión a SQL Server -------------------------------------------

# Host o IP de la instancia. Para instancia con nombre usa solo el host
# aquí y el puerto TCP en DB_PORT (el driver tedious no resuelve
# `HOST\INSTANCIA` sin el SQL Browser).
DB_SERVER=localhost

# Puerto TCP. La instancia local SQL2022 de este proyecto escucha en
# 14330, NO en el 1433 por defecto.
DB_PORT=14330

# OBLIGATORIA. Sin ella getSqlConfig() lanza error (lib/db/config.ts:9).
DB_NAME=DMC_Contingencia

# Autenticación SQL. Se ignoran si DB_TRUSTED_CONNECTION=true.
DB_USER=
DB_PASSWORD=

# Windows Integrated Security.
# AVISO: con mssql@11 (driver tedious) esta opción NO funciona todavía;
# requiere el driver msnodesqlv8 o autenticación NTLM. Déjala en false.
DB_TRUSTED_CONNECTION=false

# --- TLS de la conexión ----------------------------------------------

# Cifrado del canal. Default: true (solo se desactiva con el literal
# "false"). Déjalo en true salvo que el servidor no soporte TLS.
DB_ENCRYPT=true

# true = acepta CUALQUIER certificado del servidor. Necesario en local
# porque SQL Server genera un cert autofirmado.
# En producción DEBE ser false: con true la conexión cifrada no valida
# contra quién habla y queda expuesta a man-in-the-middle.
DB_TRUST_SERVER_CERT=false

# --- Pool de conexiones ----------------------------------------------

# Conexiones máximas simultáneas. 10 alcanza para desarrollo; súbelo en
# producción según la concurrencia real y el límite del servidor SQL.
DB_POOL_MAX=10
