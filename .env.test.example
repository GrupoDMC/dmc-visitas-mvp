# Tests de base de datos y E2E · plantilla (copia a .env.test, que git ignora).
#
# Deben apuntar SIEMPRE a un SQL Server de TU MÁQUINA. Los tests crean una base
# desechable `dmc_test_<id>`, le aplican sql/dmc_contingencia_sqlserver.sql y la
# borran al terminar. tests/setup/guarda-bd.ts rechaza cualquier servidor que no
# sea localhost y cualquier base que no lleve ese prefijo.
#
# Alta única del login (con una cuenta administradora local):
#   CREATE LOGIN dmc_test_runner WITH PASSWORD = N'<clave>', CHECK_POLICY = OFF;
#   ALTER SERVER ROLE dbcreator ADD MEMBER dmc_test_runner;
#
# Sin este archivo, `npm run test:bd` y `npm run test:e2e` se saltan solos.
TEST_DB_SERVER=localhost
TEST_DB_PORT=1433
TEST_DB_USER=dmc_test_runner
TEST_DB_PASSWORD=
