# =====================================================================
# DMC · Formulario de Visitas — variables de entorno
# Copiá este archivo como .env.local y completá los valores.
# Los tres valores salen de Supabase → Project Settings → API.
# =====================================================================

# URL del proyecto Supabase. Ej: https://abcdefghijklm.supabase.co
# Pública: viaja al navegador. No es un secreto.
NEXT_PUBLIC_SUPABASE_URL=

# Clave anónima / publishable del proyecto.
# Pública: viaja al navegador. No es un secreto.
# Con RLS en deny-all esta clave no puede leer ni escribir datos de negocio;
# se usa solo para el manejo de la sesión de Auth desde el servidor.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave service_role. SECRETO. Nunca lleva el prefijo NEXT_PUBLIC_ y nunca
# se importa desde un componente de cliente: saltea RLS por completo.
# Es la única clave con la que la app lee y escribe datos de negocio, siempre
# desde Server Components y Server Actions.
SUPABASE_SERVICE_ROLE_KEY=
